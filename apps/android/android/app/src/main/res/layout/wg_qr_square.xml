<?xml version="1.0" encoding="utf-8"?>
<!-- "QR nhận tiền" 2x2: the QR code alternates with the account card. Tap opens the enlarged QR. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:padding="10dp">

    <ViewFlipper
        android:id="@+id/r_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="8000"
        android:inAnimation="@anim/wg_in"
        android:outAnimation="@anim/wg_out">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/wg_qr_frame"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/r_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/wg_qr_title"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wg_qr_sample" />
            </FrameLayout>

            <TextView
                android:id="@+id/r_caption"
                style="@style/WgText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/wg_sample_bank_line"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_wg_bank" />

            <TextView
                android:id="@+id/r_bank"
                style="@style/WgText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wg_sample_bank"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/r_masked"
                style="@style/WgText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/wg_sample_masked" />

            <TextView
                android:id="@+id/r_holder"
                style="@style/WgText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_holder" />

            <TextView
                style="@style/WgText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wg_qr_tap_hint" />
        </LinearLayout>
    </ViewFlipper>
</FrameLayout>
