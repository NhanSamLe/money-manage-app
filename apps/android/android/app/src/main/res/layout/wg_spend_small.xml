<?xml version="1.0" encoding="utf-8"?>
<!-- "Chi tiêu hôm nay" 2x2. Default texts are sample data for the widget picker preview; the provider overwrites all. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/WgText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wg_spend_title" />

        <ImageView
            android:id="@+id/s_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/wg_icon_circle"
            android:contentDescription="@string/wg_refresh"
            android:padding="6dp"
            android:src="@drawable/ic_wg_refresh" />

        <ImageView
            android:id="@+id/s_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/wg_button_circle"
            android:contentDescription="@string/wg_act_expense_long"
            android:padding="6dp"
            android:src="@drawable/ic_wg_add"
            android:tint="@color/wg_button_icon" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/s_flip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="5000"
        android:inAnimation="@anim/wg_in"
        android:outAnimation="@anim/wg_out">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s_today_label"
                style="@style/WgText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_today" />

            <TextView
                android:id="@+id/s_today"
                style="@style/WgText.Big"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_today" />

            <TextView
                android:id="@+id/s_today_sub"
                style="@style/WgText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_today_sub" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s_month_label"
                style="@style/WgText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_sample_month_label" />

            <TextView
                android:id="@+id/s_month"
                style="@style/WgText.Big"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_month" />

            <TextView
                android:id="@+id/s_month_sub"
                style="@style/WgText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_month_sub" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s_left_label"
                style="@style/WgText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wg_budget_left" />

            <TextView
                android:id="@+id/s_left"
                style="@style/WgText.Big"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_left" />

            <TextView
                android:id="@+id/s_left_sub"
                style="@style/WgText.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/wg_sample_left_sub" />
        </LinearLayout>
    </ViewFlipper>

    <ProgressBar
        android:id="@+id/s_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginEnd="4dp"
        android:max="100"
        android:progress="62"
        android:progressDrawable="@drawable/wg_progress" />

    <ProgressBar
        android:id="@+id/s_progress_over"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginEnd="4dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/wg_progress_over"
        android:visibility="gone" />

    <TextView
        android:id="@+id/s_updated"
        style="@style/WgText.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/wg_sample_updated"
        android:textSize="9.5sp" />
</LinearLayout>
