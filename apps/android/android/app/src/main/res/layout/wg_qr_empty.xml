<?xml version="1.0" encoding="utf-8"?>
<!-- "QR nhận tiền" when no bank account is linked yet (or before the first sync). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/wg_icon_circle"
        android:importantForAccessibility="no"
        android:padding="7dp"
        android:src="@drawable/ic_wg_bank" />

    <TextView
        android:id="@+id/r_empty_title"
        style="@style/WgText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/wg_qr_unlinked"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/r_empty_btn"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/wg_button_pill"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/wg_qr_link_btn"
        android:textColor="@color/wg_button_icon"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
