<?xml version="1.0" encoding="utf-8"?>
<!-- "Trợ lý tài chính" 4x1 / 2x1: search-bar-like pill that opens the AI assistant. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:padding="7dp">

    <LinearLayout
        android:id="@+id/a_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/wg_button_circle"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_wg_ai"
            android:tint="@color/wg_button_icon" />

        <TextView
            style="@style/WgText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/wg_ai_hint"
            android:textColor="@color/wg_text_muted"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/a_photo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/wg_icon_circle"
            android:contentDescription="@string/wg_act_scan_long"
            android:padding="8dp"
            android:src="@drawable/ic_wg_camera" />
    </LinearLayout>
</FrameLayout>
