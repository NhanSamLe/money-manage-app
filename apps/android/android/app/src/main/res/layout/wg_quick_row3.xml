<?xml version="1.0" encoding="utf-8"?>
<!-- Layout of the "Thao tác nhanh" widget (2x1 row). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/q_out"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:contentDescription="@string/wg_act_expense_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_wg_out" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/wg_act_expense"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_in"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:contentDescription="@string/wg_act_income_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_wg_in" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/wg_act_income"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:contentDescription="@string/wg_act_receive_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="7dp"
                android:src="@drawable/ic_wg_qr" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/wg_act_receive"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
