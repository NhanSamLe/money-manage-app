<?xml version="1.0" encoding="utf-8"?>
<!-- Layout of the "Thao tác nhanh" widget (4x2 grid). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/WgText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wg_brand"
            android:textSize="15sp" />

        <TextView
            style="@style/WgText.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/wg_quick_label" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/q_out"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/wg_glass"
            android:contentDescription="@string/wg_act_expense_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_wg_out" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wg_act_expense"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_in"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/wg_glass"
            android:contentDescription="@string/wg_act_income_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_wg_in" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wg_act_income"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/wg_glass"
            android:contentDescription="@string/wg_act_receive_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_wg_qr" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wg_act_receive"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/wg_glass"
            android:contentDescription="@string/wg_act_ai"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_wg_ai" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wg_act_ai"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/q_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp" android:background="@drawable/wg_glass"
            android:contentDescription="@string/wg_act_scan_long"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/wg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_wg_receipt" />

            <TextView
                style="@style/WgText.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wg_act_scan"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
