<?xml version="1.0" encoding="utf-8"?>
<!-- "QR nhận tiền" 2x1 / 4x1: compact button that opens the enlarged QR. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/wg_button_circle"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_wg_qr"
        android:tint="@color/wg_button_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/WgText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wg_qr_title" />

        <TextView
            android:id="@+id/r_caption"
            style="@style/WgText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/wg_sample_bank_line" />
    </LinearLayout>
</LinearLayout>
