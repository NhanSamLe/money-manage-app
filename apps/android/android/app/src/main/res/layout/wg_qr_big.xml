<?xml version="1.0" encoding="utf-8"?>
<!-- "QR nhận tiền" 3x3 and larger: header, large QR, account line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/wg_icon_circle"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_wg_qr" />

        <TextView
            style="@style/WgText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/wg_qr_title" />

        <TextView
            style="@style/WgText.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wg_vietqr" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/wg_qr_frame"
        android:padding="8dp">

        <ImageView
            android:id="@+id/r_qr"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/wg_qr_title"
            android:scaleType="fitCenter"
            android:src="@drawable/wg_qr_sample" />
    </FrameLayout>

    <TextView
        android:id="@+id/r_bank"
        style="@style/WgText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wg_sample_bank" />

    <TextView
        android:id="@+id/r_masked"
        style="@style/WgText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/wg_sample_masked_holder" />
</LinearLayout>
