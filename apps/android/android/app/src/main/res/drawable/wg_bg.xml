<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background: emerald -> teal -> mint gradient, a wave/blob layer and a 1dp light inner border. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:type="linear"
                android:startColor="@color/wg_grad_start"
                android:centerColor="@color/wg_grad_mid"
                android:endColor="@color/wg_grad_end" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/wg_blob" />
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/wg_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
