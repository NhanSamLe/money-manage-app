<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home-screen widget text: white on the brand gradient with a soft shadow for contrast. -->
    <style name="WgText">
        <item name="android:textColor">@color/wg_text</item>
        <item name="android:shadowColor">@color/wg_text_shadow</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WgText.Label">
        <item name="android:textColor">@color/wg_text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="WgText.Small">
        <item name="android:textColor">@color/wg_text_muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="WgText.Title">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WgText.Big">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">13sp</item>
        <item name="android:autoSizeMaxTextSize">24sp</item>
    </style>

    <style name="WgText.Action">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Translucent overlay windows started from the widgets (quick entry, enlarged QR). -->
    <style name="MomaOverlayTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
