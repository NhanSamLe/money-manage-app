<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: lets MoMa open the system installer for a downloaded release APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Assistant voice input (speech_to_text): audio goes to the phone's speech service, MoMa keeps none. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Restores the optional "Thanh ghi nhanh" notification after a reboot (D-026). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="MoMa"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep links from the launcher shortcuts and the home-screen widget: moma://app/<route> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="moma" android:host="app"/>
            </intent-filter>
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>
        <!-- Home-screen widgets. "Thao tác nhanh" keeps the original class name so placed widgets keep working. -->
        <receiver
            android:name=".MomaWidgetProvider"
            android:label="@string/wg_quick_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/moma_widget_info"/>
        </receiver>
        <receiver
            android:name=".SpendWidgetProvider"
            android:label="@string/wg_spend_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wg_spend_info"/>
        </receiver>
        <receiver
            android:name=".QrWidgetProvider"
            android:label="@string/wg_qr_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wg_qr_info"/>
        </receiver>
        <receiver
            android:name=".AssistantWidgetProvider"
            android:label="@string/wg_ai_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wg_ai_info"/>
        </receiver>
        <!-- Widget buttons that act without opening the app (background refresh). -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false"/>
        <!-- Quick Settings tile "Ghi chi nhanh" (opens the quick-entry sheet) and the quick bar boot hook (D-026). -->
        <service
            android:name=".QuickEntryTileService"
            android:exported="true"
            android:icon="@drawable/ic_wg_add"
            android:label="@string/tile_quick_entry"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver
            android:name=".QuickBarBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Translucent sheets started from widgets: quick entry (Flutter) and enlarged receive QR (native). -->
        <activity
            android:name=".QuickEntryActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="vn.moma.app.quickentry"
            android:launchMode="singleTask"
            android:theme="@style/MomaOverlayTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".QrOverlayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="vn.moma.app.qroverlay"
            android:theme="@style/MomaOverlayTheme"/>
        <!-- Share target: "Chia sẻ" a receipt screenshot or a transaction text from MoMo / a bank app into MoMa. -->
        <activity
            android:name=".ShareReceiveActivity"
            android:label="@string/share_label"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="vn.moma.app.share"
            android:launchMode="singleTask"
            android:theme="@style/MomaOverlayTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Copy icon on the QR widget: copies the account number and finishes at once. -->
        <activity
            android:name=".CopyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="vn.moma.app.copy"
            android:theme="@style/MomaOverlayTheme"/>
        <!-- Reads balance-change notifications of allow-listed bank / wallet apps only (user must grant access). -->
        <service
            android:name=".MomaNotificationListener"
            android:label="MoMa"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- In-app update: shares only cache/updates/ with the package installer (see ApkInstaller.kt). -->
        <provider
            android:name=".MomaUpdateFileProvider"
            android:authorities="${applicationId}.moma_update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Supported bank / wallet apps (MomaNotificationListener.ALLOWED_PACKAGES): lets MoMa see which are installed
             on Android 11+ ("Phát hiện trên máy"). Keep in sync with the listener's allow-list. -->
        <package android:name="com.VCB"/>
        <package android:name="vn.com.techcombank.bb.app"/>
        <package android:name="com.mbmobile"/>
        <package android:name="com.tpb.mb.gprsandroid"/>
        <package android:name="com.vnpay.bidv"/>
        <package android:name="com.vietinbank.ipay"/>
        <package android:name="mobile.acb.com.vn"/>
        <package android:name="com.vnpay.vpbankonline"/>
        <package android:name="com.sacombank.ewallet"/>
        <package android:name="com.vnpay.Agribank3g"/>
        <package android:name="com.mservice.momotransfer"/>
        <package android:name="vn.com.vng.zalopay"/>
        <package android:name="com.beeasy.toppay"/>
        <package android:name="com.vib.myvib2"/>
        <package android:name="com.vnpay.hdbank"/>
        <package android:name="vn.com.msb.smartBanking"/>
        <package android:name="vn.com.ocb.awe"/>
        <package android:name="xyz.be.cake"/>
        <package android:name="vn.com.seabank.mb1"/>
        <package android:name="vn.shb.saha.mbanking"/>
        <package android:name="vn.shb.mbanking"/>
        <package android:name="com.vnpay.EximBankOmni"/>
        <package android:name="io.lifestyle.plus"/>
        <package android:name="com.bplus.vtpay"/>
        <package android:name="vnptpay.vnptmedia.vnpt.com.vnptpay"/>
        <package android:name="vn.com.lpbank.digibank"/>
        <package android:name="vn.com.lpb.lienviet24h"/>
        <package android:name="vnpay.smartacccount"/>
        <!-- Android 11+: see the speech recognizer (voice input) and the text-to-speech engine (spoken replies). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
