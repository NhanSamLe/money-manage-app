{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIAction",
  "oneOf": [
    {
      "$ref": "#/$defs/ASK"
    },
    {
      "$ref": "#/$defs/CREATE"
    },
    {
      "$ref": "#/$defs/ANNOTATE"
    },
    {
      "$ref": "#/$defs/CREATE_DEBT"
    },
    {
      "$ref": "#/$defs/LINK_DEBT"
    },
    {
      "$ref": "#/$defs/ALLOCATE_GOAL"
    },
    {
      "$ref": "#/$defs/QUERY"
    }
  ],
  "$defs": {
    "ASK": {
      "type": "object",
      "properties": {
        "action": {
          "const": "ASK"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "missing_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "minItems": 1,
              "maxItems": 10
            }
          },
          "required": [
            "question",
            "missing_fields"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    },
    "CREATE": {
      "type": "object",
      "properties": {
        "action": {
          "const": "CREATE"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "INCOME",
                "EXPENSE",
                "TRANSFER",
                "REFUND_EXPENSE",
                "REFUND_INCOME",
                "UNKNOWN_CREDIT",
                "UNKNOWN_DEBIT"
              ]
            },
            "amount_vnd": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "effective_at": {
              "type": "string",
              "format": "date-time"
            },
            "category_id": {
              "type": "string",
              "format": "uuid"
            },
            "to_account_id": {
              "type": "string",
              "format": "uuid"
            },
            "note": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            "related_tx_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "amount_vnd",
            "account_id",
            "effective_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    },
    "ANNOTATE": {
      "type": "object",
      "properties": {
        "action": {
          "const": "ANNOTATE"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "tx_id": {
              "type": "string",
              "format": "uuid"
            },
            "note": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            "category_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "tx_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    },
    "CREATE_DEBT": {
      "type": "object",
      "properties": {
        "action": {
          "const": "CREATE_DEBT"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "direction": {
              "type": "string",
              "enum": [
                "RECEIVABLE",
                "PAYABLE"
              ]
            },
            "principal": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$"
            },
            "contact_id": {
              "type": "string",
              "format": "uuid"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "originated_at": {
              "type": "string",
              "format": "date-time"
            },
            "due_date": {
              "type": "string",
              "format": "date"
            },
            "existing_tx_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "direction",
            "principal",
            "contact_id",
            "originated_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    },
    "LINK_DEBT": {
      "type": "object",
      "properties": {
        "action": {
          "const": "LINK_DEBT"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "debt_id": {
              "type": "string",
              "format": "uuid"
            },
            "tx_id": {
              "type": "string",
              "format": "uuid"
            },
            "principal": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$"
            },
            "interest": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$"
            }
          },
          "required": [
            "debt_id",
            "tx_id",
            "principal"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    },
    "ALLOCATE_GOAL": {
      "type": "object",
      "properties": {
        "action": {
          "const": "ALLOCATE_GOAL"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "goal_id": {
              "type": "string",
              "format": "uuid"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "amount_vnd": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|9000000000000000)$"
            }
          },
          "required": [
            "goal_id",
            "account_id",
            "amount_vnd"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    },
    "QUERY": {
      "type": "object",
      "properties": {
        "action": {
          "const": "QUERY"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "confidence": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "enum": [
                "summary",
                "list_transactions",
                "debt_summary",
                "budget_status",
                "goal_status",
                "account_balances"
              ]
            },
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            },
            "month": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "category_id": {
              "type": "string",
              "format": "uuid"
            },
            "contact_id": {
              "type": "string",
              "format": "uuid"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "tool"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "reason",
        "confidence",
        "payload"
      ],
      "additionalProperties": false
    }
  }
}
